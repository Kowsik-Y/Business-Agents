# Root environment variables — see docs/01-monorepo-structure.md
# Copy to .env and fill in values. Never commit real secrets.

# General
ENVIRONMENT=development
LOG_LEVEL=debug

# Infrastructure URLs (defaults match compose.yaml)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/csp_dev
REDIS_URL=redis://localhost:6380
NATS_URL=nats://localhost:4222

# Service URLs (defaults match docs/19-local-development.md)
CORE_API_URL=http://localhost:8000
AI_ORCHESTRATOR_URL=http://localhost:8100
KNOWLEDGE_SERVICE_URL=http://localhost:8200
VOICE_SERVICE_URL=http://localhost:8300

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# OpenAI — required for AI Orchestrator (Phase 4+)
OPENAI_API_KEY=sk-REPLACE_ME

# MinIO / Object Storage
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
