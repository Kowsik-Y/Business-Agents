{
  "name": "customer-success-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Omnichannel AI-powered Customer Success Platform",
  "scripts": {
    "start": "./run_all_services.sh",
    "start:all": "./run_all_services.sh",
    "dev:all": "./run_all_services.sh",
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:e2e": "turbo test:e2e",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\""
  },
  "devDependencies": {
    "concurrently": "^10.0.4",
    "prettier": "^3.5.0",
    "tsx": "^4.19.0",
    "turbo": "^2.5.0"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.0.0"
  }
}
