# Environment Configuration
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# LLM Provider Configuration
# Options: "simulator" (offline workshop mode, zero API cost), "openai", "anthropic", "gemini"
DEFAULT_LLM_PROVIDER=simulator
DEFAULT_MODEL_NAME=gpt-4o

# API Keys (leave empty to use simulator mode)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Agent Execution Limits
MAX_LOOP_ITERATIONS=8
TOOL_TIMEOUT_SECONDS=15
