{
  "name": "@csp/core-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "migration:generate": "drizzle-kit generate",
    "migration:run": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@csp/auth": "workspace:*",
    "@csp/contracts": "workspace:*",
    "@csp/events": "workspace:*",
    "@csp/logger": "workspace:*",
    "@csp/observability": "workspace:*",
    "@fastify/static": "^10.1.2",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-fastify": "^11.1.0",
    "@nestjs/swagger": "^11.2.0",
    "@types/ws": "^8.18.1",
    "drizzle-orm": "^0.44.0",
    "fastify": "^5.2.0",
    "postgres": "^3.4.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "ws": "^8.21.2",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@csp/eslint-config": "workspace:*",
    "@csp/typescript-config": "workspace:*",
    "@types/node": ">=20.0.0",
    "drizzle-kit": "^0.31.0",
    "eslint": "^9.28.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}